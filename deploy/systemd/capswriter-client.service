[Unit]
Description=CapsWriter Offline 语音输入客户端
After=graphical-session.target capswriter-server.service
Wants=capswriter-server.service
PartOf=graphical-session.target

[Service]
Type=simple
WorkingDirectory=%h/localrepo/CapsWriter-Offline
Environment=PYTHONIOENCODING=utf-8
ExecStart=%h/localrepo/CapsWriter-Offline/scripts/start-client.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
